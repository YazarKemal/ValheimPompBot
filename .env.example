# ---------------------------------------------------------------------------
# ValheimPompBot - example environment file
#
# Copy this file to `.env` and replace the placeholders with real values.
# `.env` is git-ignored. This file is tracked and must contain PLACEHOLDERS ONLY.
# Never commit a real token or API key.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
# Developer Portal -> Applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here
# Developer Portal -> Applications -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=000000000000000000
# Right-click your server -> Copy Server ID. Required for a live setup apply.
DISCORD_GUILD_ID=000000000000000000
# Safety gate: a live apply aborts unless the connected guild has this name.
DISCORD_EXPECTED_GUILD_NAME=MiningFools

# --- Bot behaviour ---------------------------------------------------------
# development | production
BOT_ENV=development
# error | warn | info | debug
LOG_LEVEL=info
# true  -> setup operations are planned and logged, but nothing is written to Discord.
# A live apply requires BOTH DRY_RUN=false AND the --confirm CLI flag.
DRY_RUN=true
# Phase 1: keep this false. The bot performs full preflight validation but does
# NOT open a gateway connection to Discord.
BOT_CONNECT=false

# --- AI provider -----------------------------------------------------------
# stub | openai | gemini | deepseek | glm
# `stub` is a deterministic offline provider used for local development and tests.
# `deepseek` is the real, paid provider. openai/gemini/glm remain placeholders.
AI_PROVIDER=stub

# Secret. Leave empty for `stub`. Never commit a real key.
# For DeepSeek: Developer Platform -> API keys.
AI_API_KEY=

# Required when AI_PROVIDER=deepseek (for example: deepseek-flash).
# There is no fallback model: an empty value makes /ask refuse to call out.
AI_MODEL=

# Per-request timeout in milliseconds (1000-600000). Enforced with AbortController.
AI_TIMEOUT_MS=30000

# --- AI request shaping and abuse limits -----------------------------------
# Upper bound on generated tokens per answer (16-32768).
AI_MAX_OUTPUT_TOKENS=1200
# Sampling temperature, 0-2. Lower is more deterministic.
AI_TEMPERATURE=0.7
# Per-user wait between /ask requests, in seconds (0-3600). 0 disables it.
AI_USER_COOLDOWN_SECONDS=10
# Longest accepted /ask prompt, in characters (1-6000). Discord's own cap is 6000.
AI_MAX_PROMPT_CHARS=6000

# Recent conversation messages PompAI keeps per user and channel (0-100).
# RAM only: a restart starts every conversation empty. 0 disables memory.
AI_HISTORY_MESSAGES=10

# Visibility of AI answers (/ask, /oyun) in every channel.
# public    -> everyone in the channel sees the answer. PRODUCT DEFAULT.
# ephemeral -> only the asker sees it. Escape hatch, not the intended behaviour.
AI_RESPONSE_VISIBILITY=public

# --- Free game alerts ------------------------------------------------------
# Background monitor for Epic + Steam giveaways. Makes no AI calls at all.
# Off by default: enabling it starts outbound requests to the stores.
FREE_GAMES_ENABLED=false

# Minutes between polls (15-1440). Values below 15 are raised to 15.
FREE_GAMES_INTERVAL_MINUTES=30

# Per-request timeout for the store sources.
FREE_GAMES_TIMEOUT_MS=15000

# How long an ended giveaway is remembered so it is never announced twice.
FREE_GAMES_RETENTION_DAYS=60

# Where announced giveaways are recorded. Empty uses data/giveaways.json.
FREE_GAMES_STATE_FILE=

# Channel that receives giveaway announcements.
FREE_GAMES_CHANNEL=bedava-oyunlar

# User-Agent sent to the store sources. Leave empty for the built-in
# descriptive default. Add your own contact here if you run this publicly.
FREE_GAMES_USER_AGENT=

# --- PompMusic (a SEPARATE Discord application) ---------------------------
# PompMusic is its own bot identity: its own token, its own command
# registration, its own intents. Do NOT reuse DISCORD_TOKEN.
#
# Enabling it REQUIRES the privileged Message Content intent on the POMPMUSIC
# application (Developer Portal -> Applications -> PompMusic -> Bot ->
# Privileged Gateway Intents -> Message Content Intent -> ON).
# PompAI no longer needs that intent at all.
POMPMUSIC_ENABLED=false

# PompMusic application credentials. Never the same values as DISCORD_*.
POMPMUSIC_TOKEN=
POMPMUSIC_CLIENT_ID=

# The ONLY channel where a plain song name starts playback.
POMPMUSIC_TEXT_CHANNEL=muzik-istek
POMPMUSIC_VOICE_CHANNEL=Müzik Odası

# true  -> PompMusic stays in voice when the queue empties and waits.
# false -> it leaves after POMPMUSIC_IDLE_DISCONNECT_SECONDS.
POMPMUSIC_STAY_CONNECTED=true

POMPMUSIC_REQUEST_COOLDOWN_SECONDS=3
POMPMUSIC_MAX_QUEUE_SIZE=50
POMPMUSIC_MAX_TRACK_MINUTES=20
POMPMUSIC_SELECTION_TIMEOUT_SECONDS=60
POMPMUSIC_SEARCH_RESULTS=5

# Only used when POMPMUSIC_STAY_CONNECTED=false.
POMPMUSIC_IDLE_DISCONNECT_SECONDS=120

# The old MUSIC_* names still work as aliases and are reported at startup.
# Rename them when convenient.

# --- Audio extraction (yt-dlp) --------------------------------------------
# Audio is extracted by yt-dlp, which must be installed separately. Nothing is
# downloaded automatically: with no yt-dlp the bot starts normally, logs that
# playback is unavailable, and every other feature keeps working.
#
#   Windows : winget install yt-dlp.yt-dlp
#   macOS   : brew install yt-dlp
#   Linux   : pipx install yt-dlp
#
# ytdlp   -> spawn yt-dlp (default)
# none    -> no playback at all; search still works
POMPMUSIC_STREAM_BACKEND=ytdlp

# Explicit path to the executable. Empty searches `yt-dlp`, then `yt-dlp.exe`,
# on PATH. Set this when yt-dlp lives somewhere PATH does not cover.
YTDLP_PATH=

# Opus inside WebM: the one format Discord decodes without transcoding, so no
# ffmpeg step is needed. Only change this if you know the replacement is also
# Opus - an m4a/AAC stream will not play.
POMPMUSIC_YTDLP_FORMAT=bestaudio[acodec=opus]

# How long yt-dlp has to start before the track is abandoned and skipped.
POMPMUSIC_YTDLP_STARTUP_TIMEOUT_MS=20000

# --- Steam giveaway discovery ----------------------------------------------
# itad    -> IsThereAnyDeal API (default, works)
# steamdb -> third-party page, normally blocked by Cloudflare. Opt-in, debug only.
# none    -> disable Steam discovery entirely
STEAM_GIVEAWAY_SOURCE=itad

# Secret. Required for STEAM_GIVEAWAY_SOURCE=itad. Never logged.
# Get one at https://isthereanydeal.com/apps/  (ITAD API key)
ITAD_API_KEY=

# --- Fun and community ------------------------------------------------------
# /kaz, /gunluk, /profil, /liderlik, /envanter, /parti, /lakap and /fal.
#
# Every reward comes from a table in the code, so this whole layer runs with
# AI_PROVIDER=stub and no API key. No game outcome ever calls a model.
#
# State lives in data/pomp-fun.sqlite (git-ignored), created automatically.

# Wait between digs. 0 disables the cooldown entirely - useful for testing,
# not for a live server.
FUN_MINE_COOLDOWN_SECONDS=300

# Rolling window between daily chests, in hours. 20 hours means "once a day"
# without a calendar or a timezone: the reset follows the user, not midnight
# in Istanbul. A streak breaks only after this window plus a day of grace.
FUN_DAILY_COOLDOWN_HOURS=20

# A little XP for chatting. This needs GuildMessages, which is NOT privileged.
# PompAI never asks for Message Content, and the message text is never read or
# stored - only the fact that a message was sent.
FUN_MESSAGE_XP_ENABLED=true

# How often one person can earn message XP. Inside the window a message costs
# a map lookup and no database write at all, so spam cannot hammer the DB.
FUN_MESSAGE_XP_COOLDOWN_SECONDS=60

# How long an idle /parti round stays alive before it is dropped.
FUN_PARTY_TIMEOUT_MINUTES=30

# Where the economy is stored. Empty uses data/pomp-fun.sqlite.
FUN_DB_FILE=

# How long a /kapisma vote stays open.
POMPMUSIC_BATTLE_SECONDS=60

# --- Deployment -------------------------------------------------------------
# Nothing here is a secret.

# auto   -> detect from Render's own RENDER marker (default)
# render -> force the Render path, including the ephemeral-storage warning
# local  -> force the local path
DEPLOY_PLATFORM=auto

# Mount point of a persistent disk, if you have one. When every state file
# under FUN_DB_FILE / FREE_GAMES_STATE_FILE lives below this path, the startup
# warning about losing runtime state is replaced by a confirmation.
#
# Render's free filesystem is ephemeral: XP, coins, inventories, daily streaks
# and the announced-giveaway ledger are all lost when the container is
# replaced. See docs/render-env.md.
PERSISTENT_STORAGE_PATH=

# Render injects PORT itself; the health endpoint binds it on 0.0.0.0 and
# defaults to 10000 when it is unset.
# PORT=10000
